{
  "name": "bmg-os",
  "private": true,
  "description": "BMG-OS — platform costing dan operasi PT Boga Makmur Gracia (SAMB Group)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --filter \"./packages/**\" --filter @bmg/web test",
    "test:golden": "tsx packages/engine/scripts/golden.ts",
    "test:rls": "bash scripts/test-rls.sh",
    "typecheck": "pnpm -r typecheck",
    "fixtures": "python3 -I scripts/extract_fixtures.py && python3 -I scripts/make_upload_fixtures.py",
    "dev": "pnpm --filter @bmg/web dev",
    "build": "pnpm --filter @bmg/web build",
    "lint:css": "node scripts/lint-css.mjs apps/web/app/globals.css",
    "snapshot:diff": "tsx packages/engine/scripts/snapshot-diff.ts",
    "snapshot:update": "tsx packages/engine/scripts/snapshot-diff.ts --update"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
