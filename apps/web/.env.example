# Optional: defaults in lib/env.ts point to the BMG-OS Supabase project. Set these to use another project (Settings → API).
# The publishable key is safe in the browser; RLS protects the data.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
# Optional: show "Masuk dengan Google" once the Google provider is enabled in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE=0
